#!/usr/bin/env bash
# disk-alarm: one loud ALARM line on ~/handoffs/BOARD.md, and a comment on the standing Linear issue, when the
# root filesystem is short of space or filling fast. Never deletes anything. Change-driven, not clock-driven:
# every landing on a ~/git store repository runs it (the store hook tools/ops/store-post-update, detached, after
# spark-cleanup --landed), aien-bays finish runs it each time a bay finishes, and any lander or gate runner may
# run it at start (`disk-alarm --quiet`).
#
# Linear: the first ALARM, each further 25 GB fall, and the "cleared" line are also posted as a comment on
# DISK_ALARM_LINEAR_ISSUE (default DRA-521, "Free space on the Spark disk"), by one direct commentCreate call
# to Linear's API (`disk-alarm --linear-comment ISSUE TEXT`, below; the key comes from atlas-vault for that
# process only). A post counts only when Linear returns the new comment's id ($STATE/linear.log). A failed
# post is kept in $STATE/linear-pending, said once on the board as an ALARM, and sent again at the next check.
# Repeats held back on the board are not posted. DISK_ALARM_LINEAR_CMD replaces the route (tests): it is run
# as `CMD ISSUE TEXT` and must print the comment id; set it to `echo off` to turn the Linear route off.
# Process names and directories in the text are cut to a fixed character set and length.
#
# What it measures (the whole filesystem, never a list of directories):
#   free  = df free bytes of the filesystem holding DISK_ALARM_FS (default /)
#   rate  = fall of free between this check and the newest earlier check at least DISK_ALARM_WINDOW_S
#           old (default 600 s; checks older than 3 h are dropped), in GB/h (GB = 10^9 bytes)
#   consumers = which processes wrote the most since that earlier check, from every process's
#           /proc/<pid>/io write_bytes (reaped children are counted in their parent), summed per real
#           working directory (readlink of /proc/<pid>/cwd: symlinks resolved, any name), plus bytes held by
#           deleted-but-open files. A writer is named wherever it runs; no path list can hide it.
# Alarm when free < DISK_ALARM_MIN_GB (default 300, the free-space target set for this disk on DRA-702, so the
# alarm comes well before the disk is full) or rate > DISK_ALARM_MAX_RATE_GBH (default 20).
# A repeat ALARM waits DISK_ALARM_REPEAT_S (default 1800 s) unless free fell another 25 GB; one
# "cleared" line is written when the condition ends.
# Cost when quiet: one df and one grep over /proc/*/io (well under a second).
#
# Test hooks: DISK_ALARM_DF (command that prints free bytes), DISK_ALARM_NOW (epoch), DISK_ALARM_PROC
# (a fake /proc tree with <pid>/io, <pid>/comm, <pid>/cwd), DISK_ALARM_BOARD, DISK_ALARM_STATE.
# Usage: disk-alarm [--quiet]   exit 0 quiet, 3 alarm (written or held back), 2 cannot measure.
set -u
H=$HOME
FS=${DISK_ALARM_FS:-/}
MIN_GB=${DISK_ALARM_MIN_GB:-300}
MAX_RATE=${DISK_ALARM_MAX_RATE_GBH:-20}
WINDOW=${DISK_ALARM_WINDOW_S:-600}
REPEAT=${DISK_ALARM_REPEAT_S:-1800}
BOARD=${DISK_ALARM_BOARD:-$H/handoffs/BOARD.md}
STATE=${DISK_ALARM_STATE:-$H/.local/state/disk-alarm}
PROC=${DISK_ALARM_PROC:-/proc}
LINEAR_ISSUE=${DISK_ALARM_LINEAR_ISSUE:-DRA-521}
QUIET=0; [ "${1:-}" = --quiet ] && QUIET=1
LINEAR_CMD=${DISK_ALARM_LINEAR_CMD:-$(readlink -f "$0") --linear-comment}
mkdir -p "$STATE/io" || exit 2

# --linear-comment ISSUE TEXT: the default Linear route. One commentCreate call; prints the new comment's id
# and exits 0, or says why on stderr and exits 1. The key is read from atlas-vault into this process only,
# never into argv or a file. Host binaries: curl (Omega has no TLS client yet), jq, atlas-vault.
if [ "${1:-}" = --linear-comment ]; then
  [ $# = 3 ] || { echo "usage: disk-alarm --linear-comment ISSUE TEXT" >&2; exit 2; }
  if [ -z "${LINEAR_API_KEY:-}" ]; then
    [ -z "${DISK_ALARM_VAULTED:-}" ] || { echo "atlas-vault gave no LINEAR_API_KEY" >&2; exit 1; }
    command -v atlas-vault >/dev/null || { echo "atlas-vault not found" >&2; exit 1; }
    export DISK_ALARM_VAULTED=1
    exec atlas-vault run LINEAR_API_KEY -- "$(readlink -f "$0")" "$@"
  fi
  out=$(jq -nc --arg i "$2" --arg b "$3" \
      '{query:"mutation($i:String!,$b:String!){commentCreate(input:{issueId:$i,body:$b}){success comment{id}}}",variables:{i:$i,b:$b}}' |
    curl -q -sS --noproxy '*' --max-time 60 -H 'Content-Type: application/json' \
      -H @<(printf 'Authorization: %s\n' "$LINEAR_API_KEY") --data-binary @- https://api.linear.app/graphql 2>&1) ||
    { echo "curl: $out" >&2; exit 1; }
  id=$(jq -r 'if .data.commentCreate.success == true then .data.commentCreate.comment.id // empty else empty end' <<<"$out" 2>/dev/null)
  [ -n "$id" ] || { echo "Linear refused: $(jq -c '.errors // .' <<<"$out" 2>/dev/null | cut -c1-300)" >&2; exit 1; }
  echo "$id"; exit 0
fi
exec 9>"$STATE/run.lock"
flock -n 9 || exit 0   # another check is running at this moment; its result stands

now=${DISK_ALARM_NOW:-$(date +%s)}
if [ -n "${DISK_ALARM_DF:-}" ]; then free=$(eval "$DISK_ALARM_DF"); else free=$(df -B1 --output=avail "$FS" | tail -n 1 | tr -d ' '); fi
[[ "$free" =~ ^[0-9]+$ ]] || { echo "disk-alarm: cannot read free space (${free:-nothing})" >&2; exit 2; }

# sample: free bytes, and every process's cumulative write_bytes (pid<TAB>bytes)
S="$STATE/samples.tsv"; touch "$S"
printf '%s\t%s\n' "$now" "$free" >> "$S"
grep -sH '^write_bytes' "$PROC"/[0-9]*/io | sed -E "s#^$PROC/([0-9]+)/io:write_bytes:[[:space:]]*#\1\t#" > "$STATE/io/$now.tsv"
# keep 3 hours of samples and their io snapshots
awk -F'\t' -v c=$((now - 10800)) '$1 >= c' "$S" > "$S.tmp" && mv "$S.tmp" "$S"
for f in "$STATE"/io/*.tsv; do t=${f##*/}; t=${t%.tsv}; [ "$t" -lt $((now - 10800)) ] && rm -f "$f"; done

# rate against the newest earlier sample at least WINDOW old
read -r t0 f0 < <(awk -F'\t' -v c=$((now - WINDOW)) '$1 <= c {t=$1; f=$2} END{if (t) print t, f}' "$S")
rate=''
[ -n "${t0:-}" ] && [ "$now" -gt "$t0" ] && rate=$(awk -v a="$f0" -v b="$free" -v dt=$((now - t0)) 'BEGIN{printf "%.1f", (a-b)/1e9*3600/dt}')
gb=$(awk -v b="$free" 'BEGIN{printf "%.1f", b/1e9}')

why=''
awk -v g="$gb" -v m="$MIN_GB" 'BEGIN{exit !(g < m)}' && why="free ${gb} GB < ${MIN_GB} GB"
if [ -n "$rate" ] && awk -v r="$rate" -v m="$MAX_RATE" 'BEGIN{exit !(r > m)}'; then
  why="${why:+$why; }falling ${rate} GB/h > ${MAX_RATE} GB/h"
fi

board_line() { ( flock -w 30 8 || exit 1; printf '%s\n' "$1" >> "$BOARD" ) 8>>"$BOARD.lock"; }
stamp() { date -u -d "@$1" +%FT%TZ; }
# Linear: a post counts only when the route prints the new comment's id. Success records it (alarm: time and
# free in last-linear; cleared: last-linear dropped) and drops any pending post. Failure keeps the post in
# linear-pending for the next check and says so once on the board. Never changes the exit status.
L="$STATE/last-linear"; P="$STATE/linear-pending"
linear_send() {  # $1 alarm|cleared, $2 text
  local id err
  if id=$(timeout 180 $LINEAR_CMD "$LINEAR_ISSUE" "$2" 2>"$STATE/linear.err" </dev/null) && [[ "$id" =~ ^[A-Za-z0-9-]+$ ]]; then
    printf '%s %s posted on %s, comment %s\n' "$(stamp "$now")" "$1" "$LINEAR_ISSUE" "$id" >> "$STATE/linear.log"
    if [ "$1" = alarm ]; then printf '%s %s\n' "$now" "$free" > "$L"; else rm -f "$L"; fi
    rm -f "$P"; return 0
  fi
  err=$(tr '\n' ' ' < "$STATE/linear.err" | tr -c 'A-Za-z0-9 ._:/=()-' ' ' | head -c 200 | sed 's/ *$//')
  printf '%s %s FAILED on %s: %s\n' "$(stamp "$now")" "$1" "$LINEAR_ISSUE" "${err:-no comment id}" >> "$STATE/linear.log"
  [ -f "$P" ] || board_line "- $(stamp "$now") **ALARM disk-alarm**: the Linear comment on $LINEAR_ISSUE failed (${err:-no comment id}); kept in $P and sent again at the next check"
  printf '%s\n%s\n' "$1" "$2" > "$P"
  return 1
}
# a post that failed at an earlier check goes first
if [ -f "$P" ]; then pk=$(head -n 1 "$P"); linear_send "$pk" "$(tail -n +2 "$P")"; fi

A="$STATE/last-alarm"
if [ -z "$why" ]; then
  if [ -f "$A" ]; then
    line="- $(stamp "$now") disk-alarm: cleared, / free ${gb} GB, falling ${rate:-unmeasured} GB/h (thresholds ${MIN_GB} GB, ${MAX_RATE} GB/h)"
    board_line "$line"
    { [ -f "$L" ] || [ -f "$P" ]; } && linear_send cleared "${line#- }"
    rm -f "$A"
  fi
  [ "$QUIET" = 1 ] || echo "disk-alarm: quiet, free ${gb} GB, falling ${rate:-unmeasured} GB/h"
  exit 0
fi
if [ -f "$A" ]; then
  read -r lt lf < "$A"
  if [ $((now - lt)) -lt "$REPEAT" ] && [ $((lf - free)) -lt 25000000000 ]; then
    [ "$QUIET" = 1 ] || echo "disk-alarm: alarm held (posted $((now - lt)) s ago): $why"
    exit 3
  fi
fi

# consumers: write_bytes since the baseline snapshot, summed per real cwd
base="$STATE/io/${t0:-x}.tsv"
if [ ! -f "$base" ]; then  # no snapshot at t0: the newest one older than this check
  bt=$(for f in "$STATE"/io/*.tsv; do t=${f##*/}; echo "${t%.tsv}"; done | awk -v n="$now" '$1 ~ /^[0-9]+$/ && $1 < n' | sort -n | tail -n 1)
  base="$STATE/io/$bt.tsv"
fi
top=''
if [ -n "$base" ] && [ -f "$base" ]; then
  since=${base##*/}; since=${since%.tsv}
  top=$(awk -F'\t' 'NR==FNR {a[$1]=$2; next} ($1 in a) && $2 > a[$1] {print $1 "\t" $2 - a[$1]}' "$base" "$STATE/io/$now.tsv" |
    sort -t$'\t' -k2,2nr | head -n 200 |
    while IFS=$'\t' read -r pid d; do
      cwd=$(readlink -f "$PROC/$pid/cwd" 2>/dev/null | tr -d '\n' | tr -c 'A-Za-z0-9._/+-' '?' | cut -c1-160)
      printf '%s\t%s\t%s\n' "${cwd:-exited}" "$d" "$(tr -d '\n' < "$PROC/$pid/comm" 2>/dev/null | tr -c 'A-Za-z0-9._+-' '?' | cut -c1-32)"
    done |
    awk -F'\t' '{s[$1]+=$2; if (!($1 in c) || $2 > m[$1]) {c[$1]=$3; m[$1]=$2}} END {for (k in s) printf "%d\t%s\t%s\n", s[k], k, c[k]}' |
    sort -t$'\t' -k1,1nr | head -n 3 |
    awk -F'\t' -v h="$H" '{p=$2; if (index(p, h "/") == 1) p="~" substr(p, length(h)+1); printf "%s%s +%.1f GB written (%s)", (NR>1 ? "; " : ""), p, $1/1e9, $3}')
  top="${top:-no process wrote} (since $(stamp "$since"))"
fi
# bytes held by deleted-but-open files (space df counts as used that no directory shows)
held=$(find "$PROC"/[0-9]*/fd -maxdepth 1 -type l -lname '*(deleted)' -printf '%p\n' 2>/dev/null |
  while read -r f; do stat -Lc %s "$f" 2>/dev/null; done | awk '{s+=$1} END{printf "%.1f", s/1e9}')

line="$(stamp "$now") ALARM disk: / free ${gb} GB, falling ${rate:-unmeasured} GB/h ($why). Top writers by real directory: ${top:-no baseline yet}. Deleted-but-open: ${held:-0} GB. Nothing deleted; see ~/.local/bin/disk-alarm; regenerable bay output: bay-clean; reviewed reclaim: spark-cleanup (dry run first)."
board_line "- ${line/ALARM disk:/**ALARM disk**}"
printf '%s %s\n' "$now" "$free" > "$A"
# Linear: the first alarm of an episode, then each further 25 GB fall
lf=''; [ -f "$L" ] && read -r _ lf < "$L"
[ -z "$lf" ] || [ $((lf - free)) -ge 25000000000 ] && linear_send alarm "$line"
[ "$QUIET" = 1 ] || echo "disk-alarm: ALARM written to $BOARD: $why"
exit 3
